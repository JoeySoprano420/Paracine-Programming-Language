module write_read_demo

import std.fs
import std.io

routine main(args: view<text>) gives int with io, alloc, trap
    if args.count != 1
        std.io.println("Usage: write_read_demo <output.txt>")
        give 2

    if not std.fs.write_text(args[0], "File created by native Paracine!\n")
        std.io.println("Could not create output file")
        give 3

    let data: string = std.fs.read_text(args[0])
    std.io.print(data.to_text())
    give 0
