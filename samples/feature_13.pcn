module file_roundtrip
import std.fs
routine main() gives int with io, alloc, trap
    let path: text = "stage1_io_fixture.txt"
    if not std.fs.write_text(path, "Hello from Paracine")
        give 1
    let contents: string = std.fs.read_text(path)
    if contents.to_text().equals("Hello from Paracine")
        give 42
    give 2
