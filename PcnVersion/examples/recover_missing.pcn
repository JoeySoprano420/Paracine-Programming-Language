module recover_missing

import std.fs as fs
import std.mem as mem
import std.io as io
import std.error as errors

routine main() gives result<void, errors.system_error>
    choose fs.open("missing.bin", fs.read_only())
        when ok(unexpected)
            try fs.close(move unexpected)
            fail errors.make(errors.invalid_argument)
        when err(problem)
            if not errors.is_kind(problem, errors.not_found)
                fail problem
    var target = try fs.open("recovered.txt", fs.create_new())
    try fs.write_all(var target, mem.bytes("recovered\n"))
    try fs.close(move target)
    try io.write_stdout("not_found\n")
    give
