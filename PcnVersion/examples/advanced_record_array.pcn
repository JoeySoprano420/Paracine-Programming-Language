module advanced_record_array

record Pair
    left: int
    right: int

routine main() gives int
    let pair: Pair = Pair{left: 20, right: 22}
    let numbers: array<int,3> = [6, 7, 8]
    var total: int = pair.left + pair.right
    for number in numbers
        total += number
    give total - 21
