module stage1_compiler

import std.fs
import std.io
import std.process

# Stage 1: a real, all-Paracine compiler frontend for a documented, typed subset.
# The target is canonical Paracine source. Stage 0 supplies the PE32+ backend.
# No PowerShell, C++, embedded source string, or Python is used by this compiler.

record Parser
    source: text
    pos: int
    error: int
    error_pos: int
    bindings: int
    name0: text
    kind0: int
    mutable0: bool
    name1: text
    kind1: int
    mutable1: bool
    name2: text
    kind2: int
    mutable2: bool
    name3: text
    kind3: int
    mutable3: bool
    name4: text
    kind4: int
    mutable4: bool
    name5: text
    kind5: int
    mutable5: bool
    name6: text
    kind6: int
    mutable6: bool
    name7: text
    kind7: int
    mutable7: bool
    name8: text
    kind8: int
    mutable8: bool
    name9: text
    kind9: int
    mutable9: bool
    name10: text
    kind10: int
    mutable10: bool
    name11: text
    kind11: int
    mutable11: bool
    name12: text
    kind12: int
    mutable12: bool
    name13: text
    kind13: int
    mutable13: bool
    name14: text
    kind14: int
    mutable14: bool
    name15: text
    kind15: int
    mutable15: bool
    name16: text
    kind16: int
    mutable16: bool
    name17: text
    kind17: int
    mutable17: bool
    name18: text
    kind18: int
    mutable18: bool
    name19: text
    kind19: int
    mutable19: bool
    name20: text
    kind20: int
    mutable20: bool
    name21: text
    kind21: int
    mutable21: bool
    name22: text
    kind22: int
    mutable22: bool
    name23: text
    kind23: int
    mutable23: bool
    name24: text
    kind24: int
    mutable24: bool
    name25: text
    kind25: int
    mutable25: bool
    name26: text
    kind26: int
    mutable26: bool
    name27: text
    kind27: int
    mutable27: bool
    name28: text
    kind28: int
    mutable28: bool
    name29: text
    kind29: int
    mutable29: bool
    name30: text
    kind30: int
    mutable30: bool
    name31: text
    kind31: int
    mutable31: bool
    routines: int
    saw_main: bool
    return_kind: int

record Result
    ok: bool
    error: int
    offset: int

# Lexer implementation ported to Paracine from the Stage-0 compiler's C++ Lexer.
# Token kinds: 1 identifier, 2 keyword, 3 number, 4 string, 5 character,
# 6 symbol, 7 newline, 8 indent, 9 dedent, 10 eof, -1 lexical error.
record LexToken
    kind: int
    start: int
    width: int
    line: int
    column: int

record Scanner
    source: text
    pos: int
    line: int
    column: int
    current_indent: int
    at_line_start: bool
    at_end: bool
    did_token: bool
    last_newline: bool
    grouping: int
    nesting: int
    pending_dedents: int
    lexical_error: int
    error_offset: int

routine scanner_new(source: text) gives Scanner with trap
    var starting: int = 0
    if source.count().to_int() >= 3
        if source.byte_at(0) == 239 and source.byte_at(1) == 187 and source.byte_at(2) == 191
            starting = 3
    give Scanner{source: source, pos: starting, line: 1, column: 1, current_indent: 0, at_line_start: true, at_end: false, did_token: false, last_newline: false, grouping: 0, nesting: 0, pending_dedents: 0, lexical_error: 0, error_offset: 0}

routine scanner_char(s: Scanner, offset: int) gives int with trap
    if s.pos + offset >= s.source.count().to_int()
        give -1
    give s.source.byte_at(s.pos + offset)

routine scanner_advance(var s: Scanner) gives void
    s.pos = s.pos + 1
    s.column = s.column + 1

routine scanner_fail(var s: Scanner, code: int) gives void
    if s.lexical_error == 0
        s.lexical_error = code
        s.error_offset = s.pos

routine scanner_linebreak(var s: Scanner) gives void
    scanner_advance(s)
    s.line = s.line + 1
    s.column = 1
    s.at_line_start = true

routine scan_kind(name: text) gives int
    if name.equals("abi") or name.equals("alias") or name.equals("alloc") or name.equals("and") or name.equals("as") or name.equals("break") or name.equals("capability") or name.equals("choose") or name.equals("const") or name.equals("continue") or name.equals("defer") or name.equals("else") or name.equals("export") or name.equals("fail") or name.equals("false") or name.equals("for") or name.equals("foreign") or name.equals("from") or name.equals("give") or name.equals("gives") or name.equals("if") or name.equals("import") or name.equals("in") or name.equals("io") or name.equals("is") or name.equals("let") or name.equals("loop") or name.equals("module") or name.equals("move") or name.equals("not") or name.equals("nothing") or name.equals("or") or name.equals("own") or name.equals("public") or name.equals("pure") or name.equals("raw") or name.equals("record") or name.equals("routine") or name.equals("static") or name.equals("test") or name.equals("then") or name.equals("to") or name.equals("until") or name.equals("thread") or name.equals("trap") or name.equals("true") or name.equals("try") or name.equals("unsafe") or name.equals("var") or name.equals("variant") or name.equals("when") or name.equals("where") or name.equals("while") or name.equals("with") or name.equals("return") or name.equals("null") or name.equals("enum") or name.equals("union") or name.equals("use") or name.equals("compile") or name.equals("layout") or name.equals("packed") or name.equals("align") or name.equals("each") or name.equals("otherwise") or name.equals("case") or name.equals("return_") or name.equals("yield_")
        give 2
    give 1

routine scanner_symbol_char(c: int) gives bool
    give c == 123 or c == 125 or c == 40 or c == 41 or c == 91 or c == 93 or c == 44 or c == 58 or c == 59 or c == 46 or c == 63 or c == 64 or c == 43 or c == 45 or c == 42 or c == 47 or c == 37 or c == 61 or c == 60 or c == 62 or c == 33 or c == 38 or c == 124 or c == 94 or c == 126

routine scanner_two_symbol(x: text) gives bool
    give x.equals("==") or x.equals("!=") or x.equals("<=") or x.equals(">=") or x.equals("&&") or x.equals("||") or x.equals("+=") or x.equals("-=") or x.equals("*=") or x.equals("/=") or x.equals("%=") or x.equals("&=") or x.equals("|=") or x.equals("^=") or x.equals("->") or x.equals("=>") or x.equals("::") or x.equals("<<") or x.equals(">>") or x.equals("..")

routine scanner_three_symbol(x: text) gives bool
    give x.equals("<<=") or x.equals(">>=") or x.equals("...") or x.equals("..=") or x.equals("..<")

routine is_numeric_digit(c: int, base: int) gives bool
    if c >= 48 and c <= 57
        give c - 48 < base
    if base == 16 and c >= 65 and c <= 70
        give true
    if base == 16 and c >= 97 and c <= 102
        give true
    give false

routine scan_digits(var s: Scanner, base: int) gives void with trap
    var got_digit: bool = false
    var preceding_digit: bool = false
    var reading: bool = true
    while reading and s.lexical_error == 0
        let c: int = scanner_char(s, 0)
        if is_numeric_digit(c, base)
            scanner_advance(s)
            got_digit = true
            preceding_digit = true
        else
            if c == 95
                if not preceding_digit or not is_numeric_digit(scanner_char(s, 1), base)
                    scanner_fail(s, 114)
                else
                    scanner_advance(s)
                    preceding_digit = false
            else
                reading = false
    if not got_digit
        scanner_fail(s, 114)

routine validate_utf8(source: text) gives int with trap
    var i: int = 0
    let n: int = source.count().to_int()
    while i < n
        let b: int = source.byte_at(i)
        if b < 128
            i += 1
        else
            var extra: int = 0
            if b >= 194 and b <= 223
                extra = 1
            if b >= 224 and b <= 239
                extra = 2
            if b >= 240 and b <= 244
                extra = 3
            if extra == 0 or i + extra >= n
                give i
            var j: int = 1
            while j <= extra
                let v: int = source.byte_at(i + j)
                if v < 128 or v > 191
                    give i + j
                j += 1
            let next: int = source.byte_at(i + 1)
            if (b == 224 and next < 160) or (b == 237 and next > 159) or (b == 240 and next < 144) or (b == 244 and next > 143)
                give i
            i = i + extra + 1
    give -1

routine scan_next(var s: Scanner) gives LexToken with trap
    if s.lexical_error != 0
        give LexToken{kind: -1, start: s.error_offset, width: 0, line: s.line, column: s.column}
    if s.pending_dedents > 0
        s.pending_dedents = s.pending_dedents - 1
        give LexToken{kind: 9, start: s.pos, width: 0, line: s.line, column: s.column}
    if s.at_end
        give LexToken{kind: 10, start: s.pos, width: 0, line: s.line, column: s.column}
    var again: bool = true
    while again and s.lexical_error == 0
        if s.at_line_start and s.nesting == 0
            var spaces: int = 0
            while scanner_char(s, 0) == 32
                spaces += 1
                scanner_advance(s)
            if scanner_char(s, 0) == 9
                scanner_fail(s, 101)
            if scanner_char(s, 0) == 35
                while scanner_char(s, 0) != -1 and scanner_char(s, 0) != 10
                    scanner_advance(s)
            if scanner_char(s, 0) == 10
                scanner_linebreak(s)
            else
                if scanner_char(s, 0) == -1
                    again = false
                else
                    if spaces % 4 != 0
                        scanner_fail(s, 102)
                    else
                        if not s.did_token and spaces != 0
                            scanner_fail(s, 103)
                        if spaces > s.current_indent + 4
                            scanner_fail(s, 103)
                        if spaces > s.current_indent
                            s.current_indent = spaces
                            s.at_line_start = false
                            give LexToken{kind: 8, start: s.pos, width: 0, line: s.line, column: s.column}
                        if spaces < s.current_indent
                            s.pending_dedents = (s.current_indent - spaces) / 4
                            s.current_indent = spaces
                            s.at_line_start = false
                            s.pending_dedents = s.pending_dedents - 1
                            give LexToken{kind: 9, start: s.pos, width: 0, line: s.line, column: s.column}
                        s.at_line_start = false
                        again = false
        else
            again = false
    if s.lexical_error != 0
        give LexToken{kind: -1, start: s.error_offset, width: 0, line: s.line, column: s.column}
    if s.at_line_start and s.nesting > 0
        s.at_line_start = false
    while scanner_char(s, 0) == 32 or scanner_char(s, 0) == 9 or scanner_char(s, 0) == 13
        scanner_advance(s)
    let begin: int = s.pos
    let line_no: int = s.line
    let col_no: int = s.column
    let c: int = scanner_char(s, 0)
    if c == -1
        if s.nesting != 0
            scanner_fail(s, 112)
            give LexToken{kind: -1, start: s.pos, width: 0, line: line_no, column: col_no}
        if s.current_indent > 0
            s.pending_dedents = s.current_indent / 4
            s.current_indent = 0
            s.pending_dedents = s.pending_dedents - 1
            give LexToken{kind: 9, start: begin, width: 0, line: line_no, column: col_no}
        s.at_end = true
        give LexToken{kind: 10, start: s.pos, width: 0, line: line_no, column: col_no}
    if c == 10
        scanner_linebreak(s)
        if s.nesting > 0
            give scan_next(s)
        if s.last_newline or not s.did_token
            give scan_next(s)
        s.last_newline = true
        give LexToken{kind: 7, start: begin, width: 1, line: line_no, column: col_no}
    if c == 35
        while scanner_char(s, 0) != -1 and scanner_char(s, 0) != 10
            scanner_advance(s)
        give scan_next(s)
    s.last_newline = false
    s.did_token = true
    if is_alpha(c)
        while is_word(scanner_char(s, 0))
            scanner_advance(s)
        give LexToken{kind: scan_kind(s.source.slice(begin, s.pos - begin)), start: begin, width: s.pos - begin, line: line_no, column: col_no}
    if is_digit(c)
        if c == 48 and (scanner_char(s, 1) == 120 or scanner_char(s, 1) == 88 or scanner_char(s, 1) == 98 or scanner_char(s, 1) == 66)
            var base: int = 16
            if scanner_char(s, 1) == 98 or scanner_char(s, 1) == 66
                base = 2
            scanner_advance(s)
            scanner_advance(s)
            scan_digits(s, base)
            if base == 2 and is_digit(scanner_char(s, 0))
                scanner_fail(s, 114)
        else
            scan_digits(s, 10)
            if scanner_char(s, 0) == 46 and is_digit(scanner_char(s, 1))
                scanner_advance(s)
                scan_digits(s, 10)
            if scanner_char(s, 0) == 101 or scanner_char(s, 0) == 69
                scanner_advance(s)
                if scanner_char(s, 0) == 43 or scanner_char(s, 0) == 45
                    scanner_advance(s)
                scan_digits(s, 10)
        if is_alpha(scanner_char(s, 0))
            scanner_fail(s, 114)
        if s.lexical_error != 0
            give LexToken{kind: -1, start: s.error_offset, width: 0, line: line_no, column: col_no}
        give LexToken{kind: 3, start: begin, width: s.pos - begin, line: line_no, column: col_no}
    if c == 34
        scanner_advance(s)
        var closed: bool = false
        while scanner_char(s, 0) != -1 and scanner_char(s, 0) != 10 and not closed
            if scanner_char(s, 0) == 92
                scanner_advance(s)
                if scanner_char(s, 0) != -1 and scanner_char(s, 0) != 10
                    scanner_advance(s)
            else
                if scanner_char(s, 0) == 34
                    scanner_advance(s)
                    closed = true
                else
                    scanner_advance(s)
        if not closed
            scanner_fail(s, 110)
            give LexToken{kind: -1, start: s.error_offset, width: 0, line: line_no, column: col_no}
        give LexToken{kind: 4, start: begin, width: s.pos - begin, line: line_no, column: col_no}
    if c == 39
        scanner_advance(s)
        let value: int = scanner_char(s, 0)
        if value == -1 or value == 10 or value == 39
            scanner_fail(s, 115)
        if value == 92
            scanner_advance(s)
            if scanner_char(s, 0) != -1 and scanner_char(s, 0) != 10
                scanner_advance(s)
        else
            var length: int = 1
            if value >= 194 and value <= 223
                length = 2
            if value >= 224 and value <= 239
                length = 3
            if value >= 240 and value <= 244
                length = 4
            while length > 0 and scanner_char(s, 0) != -1 and scanner_char(s, 0) != 10
                scanner_advance(s)
                length -= 1
        if scanner_char(s, 0) != 39
            scanner_fail(s, 115)
        else
            scanner_advance(s)
        if s.lexical_error != 0
            give LexToken{kind: -1, start: s.error_offset, width: 0, line: line_no, column: col_no}
        give LexToken{kind: 5, start: begin, width: s.pos - begin, line: line_no, column: col_no}
    if scanner_symbol_char(c)
        var symbol_width: int = 1
        if s.pos + 3 <= s.source.count().to_int()
            if scanner_three_symbol(s.source.slice(s.pos, 3))
                symbol_width = 3
        if symbol_width == 1 and s.pos + 2 <= s.source.count().to_int()
            if scanner_two_symbol(s.source.slice(s.pos, 2))
                symbol_width = 2
        if symbol_width == 1
            if c == 40 or c == 91 or c == 123
                if s.nesting >= 24
                    scanner_fail(s, 116)
                else
                    var kind: int = 1
                    if c == 91
                        kind = 2
                    if c == 123
                        kind = 3
                    s.grouping = s.grouping * 4 + kind
                    s.nesting = s.nesting + 1
            if c == 41 or c == 93 or c == 125
                var expected: int = 1
                if c == 93
                    expected = 2
                if c == 125
                    expected = 3
                if s.nesting == 0 or s.grouping % 4 != expected
                    scanner_fail(s, 111)
                else
                    s.grouping = s.grouping / 4
                    s.nesting = s.nesting - 1
        while symbol_width > 0
            scanner_advance(s)
            symbol_width -= 1
        if s.lexical_error != 0
            give LexToken{kind: -1, start: s.error_offset, width: 0, line: line_no, column: col_no}
        give LexToken{kind: 6, start: begin, width: s.pos - begin, line: line_no, column: col_no}
    scanner_fail(s, 109)
    give LexToken{kind: -1, start: s.error_offset, width: 0, line: line_no, column: col_no}

routine lexical_preflight(source: text) gives Result with trap
    let bad_utf8: int = validate_utf8(source)
    if bad_utf8 >= 0
        give Result{ok: false, error: 118, offset: bad_utf8}
    var scanner: Scanner = scanner_new(source)
    var count: int = 0
    var running: bool = true
    while running and count < 1000000
        let next: LexToken = scan_next(scanner)
        if next.kind == -1
            give Result{ok: false, error: scanner.lexical_error, offset: scanner.error_offset}
        if next.kind == 10
            running = false
        count += 1
    if count >= 1000000
        give Result{ok: false, error: 117, offset: scanner.pos}
    give Result{ok: true, error: 0, offset: 0}

routine token_name(kind: int) gives text
    if kind == 1
        give "identifier"
    if kind == 2
        give "keyword"
    if kind == 3
        give "number"
    if kind == 4
        give "string"
    if kind == 5
        give "character"
    if kind == 6
        give "symbol"
    if kind == 7
        give "newline"
    if kind == 8
        give "indent"
    if kind == 9
        give "dedent"
    if kind == 10
        give "eof"
    give "error"

routine dump_tokens(source: text) gives int with alloc, trap, io
    var scanner: Scanner = scanner_new(source)
    var going: bool = true
    while going
        let item: LexToken = scan_next(scanner)
        if item.kind == -1
            give report_error(source, Result{ok: false, error: scanner.lexical_error, offset: scanner.error_offset})
        var output = "".to_string()
        output.append(number_text(item.line).to_text())
        output.append(":")
        output.append(number_text(item.column).to_text())
        output.append(" ")
        output.append(token_name(item.kind))
        if item.width > 0 and item.kind != 7
            output.append(" ")
            output.append(source.slice(item.start, item.width))
        output.append("\n")
        if not output.to_text().stdout_write()
            give 3
        if item.kind == 10
            going = false
    give 0

routine length(p: Parser) gives int with trap
    give p.source.count().to_int()

routine at(p: Parser) gives int with trap
    if p.pos >= length(p)
        give -1
    give p.source.byte_at(p.pos)

routine at_offset(p: Parser, offset: int) gives int with trap
    if p.pos + offset >= length(p)
        give -1
    give p.source.byte_at(p.pos + offset)

routine set_error(var p: Parser, code: int) gives void
    if p.error == 0
        p.error = code
        p.error_pos = p.pos

routine is_alpha(c: int) gives bool
    give (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95

routine is_digit(c: int) gives bool
    give c >= 48 and c <= 57

routine is_word(c: int) gives bool
    give is_alpha(c) or is_digit(c)

routine skip_space(var p: Parser) gives void with trap
    while at(p) == 32 or at(p) == 9 or at(p) == 13
        p.pos = p.pos + 1

routine skip_empty(var p: Parser) gives void with trap
    var again: bool = true
    while again and p.error == 0
        var look: int = p.pos
        while look < length(p) and (p.source.byte_at(look) == 32 or p.source.byte_at(look) == 9 or p.source.byte_at(look) == 13)
            look += 1
        if look >= length(p)
            p.pos = look
            again = false
        else
            if p.source.byte_at(look) == 10
                p.pos = look + 1
            else
                if p.source.byte_at(look) == 35
                    p.pos = look
                    while at(p) != 10 and at(p) != -1
                        p.pos = p.pos + 1
                    if at(p) == 10
                        p.pos = p.pos + 1
                else
                    again = false

routine identifier(var p: Parser) gives text with trap
    skip_space(p)
    if not is_alpha(at(p))
        set_error(p, 1)
        give ""
    let start: int = p.pos
    while is_word(at(p))
        p.pos = p.pos + 1
    give p.source.slice(start, p.pos - start)

routine keyword(var p: Parser, wanted: text) gives bool with trap
    let previous: int = p.pos
    skip_space(p)
    if not is_alpha(at(p))
        p.pos = previous
        give false
    let begin: int = p.pos
    while is_word(at(p))
        p.pos = p.pos + 1
    if p.source.slice(begin, p.pos - begin).equals(wanted)
        give true
    p.pos = previous
    give false

routine require_keyword(var p: Parser, wanted: text) gives void with trap
    if not keyword(p, wanted)
        set_error(p, 2)

routine token(var p: Parser, wanted: text) gives bool with trap
    let previous: int = p.pos
    skip_space(p)
    let count: int = wanted.count().to_int()
    if p.pos + count > length(p)
        p.pos = previous
        give false
    if wanted.equals("&") and at_offset(p, 1) == 38
        p.pos = previous
        give false
    if wanted.equals("|") and at_offset(p, 1) == 124
        p.pos = previous
        give false
    if p.source.slice(p.pos, count).equals(wanted)
        p.pos = p.pos + count
        give true
    p.pos = previous
    give false

routine require_token(var p: Parser, wanted: text) gives void with trap
    if not token(p, wanted)
        set_error(p, 3)

routine line_end(var p: Parser) gives void with trap
    skip_space(p)
    if at(p) == 35
        while at(p) != 10 and at(p) != -1
            p.pos = p.pos + 1
    if at(p) == 10
        p.pos = p.pos + 1
    else
        if at(p) != -1
            set_error(p, 4)

routine indentation(var p: Parser) gives int with trap
    skip_empty(p)
    var point: int = p.pos
    var spaces: int = 0
    while point < length(p) and p.source.byte_at(point) == 32
        spaces += 1
        point += 1
    if point < length(p) and p.source.byte_at(point) == 9
        set_error(p, 5)
    give spaces

# Symbol table is serialized as |name:kind| entries, with kind 1=int, 2=bool.
# Fixed-size symbol environment is intentional for the Stage-1 bootstrap.
# Scopes are implemented by rolling back `bindings` at block exit.
routine symbol_kind(p: Parser, name: text) gives int
    if p.bindings > 0 and p.name0.equals(name)
        give p.kind0
    if p.bindings > 1 and p.name1.equals(name)
        give p.kind1
    if p.bindings > 2 and p.name2.equals(name)
        give p.kind2
    if p.bindings > 3 and p.name3.equals(name)
        give p.kind3
    if p.bindings > 4 and p.name4.equals(name)
        give p.kind4
    if p.bindings > 5 and p.name5.equals(name)
        give p.kind5
    if p.bindings > 6 and p.name6.equals(name)
        give p.kind6
    if p.bindings > 7 and p.name7.equals(name)
        give p.kind7
    if p.bindings > 8 and p.name8.equals(name)
        give p.kind8
    if p.bindings > 9 and p.name9.equals(name)
        give p.kind9
    if p.bindings > 10 and p.name10.equals(name)
        give p.kind10
    if p.bindings > 11 and p.name11.equals(name)
        give p.kind11
    if p.bindings > 12 and p.name12.equals(name)
        give p.kind12
    if p.bindings > 13 and p.name13.equals(name)
        give p.kind13
    if p.bindings > 14 and p.name14.equals(name)
        give p.kind14
    if p.bindings > 15 and p.name15.equals(name)
        give p.kind15
    if p.bindings > 16 and p.name16.equals(name)
        give p.kind16
    if p.bindings > 17 and p.name17.equals(name)
        give p.kind17
    if p.bindings > 18 and p.name18.equals(name)
        give p.kind18
    if p.bindings > 19 and p.name19.equals(name)
        give p.kind19
    if p.bindings > 20 and p.name20.equals(name)
        give p.kind20
    if p.bindings > 21 and p.name21.equals(name)
        give p.kind21
    if p.bindings > 22 and p.name22.equals(name)
        give p.kind22
    if p.bindings > 23 and p.name23.equals(name)
        give p.kind23
    if p.bindings > 24 and p.name24.equals(name)
        give p.kind24
    if p.bindings > 25 and p.name25.equals(name)
        give p.kind25
    if p.bindings > 26 and p.name26.equals(name)
        give p.kind26
    if p.bindings > 27 and p.name27.equals(name)
        give p.kind27
    if p.bindings > 28 and p.name28.equals(name)
        give p.kind28
    if p.bindings > 29 and p.name29.equals(name)
        give p.kind29
    if p.bindings > 30 and p.name30.equals(name)
        give p.kind30
    if p.bindings > 31 and p.name31.equals(name)
        give p.kind31
    give 0

routine declare_symbol(var p: Parser, name: text, kind: int, mutable: bool) gives void
    if symbol_kind(p, name) != 0
        set_error(p, 8)
    else
        if p.bindings == 0
            p.name0 = name
            p.kind0 = kind
            p.mutable0 = mutable
        if p.bindings == 1
            p.name1 = name
            p.kind1 = kind
            p.mutable1 = mutable
        if p.bindings == 2
            p.name2 = name
            p.kind2 = kind
            p.mutable2 = mutable
        if p.bindings == 3
            p.name3 = name
            p.kind3 = kind
            p.mutable3 = mutable
        if p.bindings == 4
            p.name4 = name
            p.kind4 = kind
            p.mutable4 = mutable
        if p.bindings == 5
            p.name5 = name
            p.kind5 = kind
            p.mutable5 = mutable
        if p.bindings == 6
            p.name6 = name
            p.kind6 = kind
            p.mutable6 = mutable
        if p.bindings == 7
            p.name7 = name
            p.kind7 = kind
            p.mutable7 = mutable
        if p.bindings == 8
            p.name8 = name
            p.kind8 = kind
            p.mutable8 = mutable
        if p.bindings == 9
            p.name9 = name
            p.kind9 = kind
            p.mutable9 = mutable
        if p.bindings == 10
            p.name10 = name
            p.kind10 = kind
            p.mutable10 = mutable
        if p.bindings == 11
            p.name11 = name
            p.kind11 = kind
            p.mutable11 = mutable
        if p.bindings == 12
            p.name12 = name
            p.kind12 = kind
            p.mutable12 = mutable
        if p.bindings == 13
            p.name13 = name
            p.kind13 = kind
            p.mutable13 = mutable
        if p.bindings == 14
            p.name14 = name
            p.kind14 = kind
            p.mutable14 = mutable
        if p.bindings == 15
            p.name15 = name
            p.kind15 = kind
            p.mutable15 = mutable
        if p.bindings == 16
            p.name16 = name
            p.kind16 = kind
            p.mutable16 = mutable
        if p.bindings == 17
            p.name17 = name
            p.kind17 = kind
            p.mutable17 = mutable
        if p.bindings == 18
            p.name18 = name
            p.kind18 = kind
            p.mutable18 = mutable
        if p.bindings == 19
            p.name19 = name
            p.kind19 = kind
            p.mutable19 = mutable
        if p.bindings == 20
            p.name20 = name
            p.kind20 = kind
            p.mutable20 = mutable
        if p.bindings == 21
            p.name21 = name
            p.kind21 = kind
            p.mutable21 = mutable
        if p.bindings == 22
            p.name22 = name
            p.kind22 = kind
            p.mutable22 = mutable
        if p.bindings == 23
            p.name23 = name
            p.kind23 = kind
            p.mutable23 = mutable
        if p.bindings == 24
            p.name24 = name
            p.kind24 = kind
            p.mutable24 = mutable
        if p.bindings == 25
            p.name25 = name
            p.kind25 = kind
            p.mutable25 = mutable
        if p.bindings == 26
            p.name26 = name
            p.kind26 = kind
            p.mutable26 = mutable
        if p.bindings == 27
            p.name27 = name
            p.kind27 = kind
            p.mutable27 = mutable
        if p.bindings == 28
            p.name28 = name
            p.kind28 = kind
            p.mutable28 = mutable
        if p.bindings == 29
            p.name29 = name
            p.kind29 = kind
            p.mutable29 = mutable
        if p.bindings == 30
            p.name30 = name
            p.kind30 = kind
            p.mutable30 = mutable
        if p.bindings == 31
            p.name31 = name
            p.kind31 = kind
            p.mutable31 = mutable
        if p.bindings >= 32
            set_error(p, 20)
        else
            p.bindings = p.bindings + 1

routine is_immutable(p: Parser, name: text) gives bool
    if p.bindings > 0 and p.name0.equals(name)
        give not p.mutable0
    if p.bindings > 1 and p.name1.equals(name)
        give not p.mutable1
    if p.bindings > 2 and p.name2.equals(name)
        give not p.mutable2
    if p.bindings > 3 and p.name3.equals(name)
        give not p.mutable3
    if p.bindings > 4 and p.name4.equals(name)
        give not p.mutable4
    if p.bindings > 5 and p.name5.equals(name)
        give not p.mutable5
    if p.bindings > 6 and p.name6.equals(name)
        give not p.mutable6
    if p.bindings > 7 and p.name7.equals(name)
        give not p.mutable7
    if p.bindings > 8 and p.name8.equals(name)
        give not p.mutable8
    if p.bindings > 9 and p.name9.equals(name)
        give not p.mutable9
    if p.bindings > 10 and p.name10.equals(name)
        give not p.mutable10
    if p.bindings > 11 and p.name11.equals(name)
        give not p.mutable11
    if p.bindings > 12 and p.name12.equals(name)
        give not p.mutable12
    if p.bindings > 13 and p.name13.equals(name)
        give not p.mutable13
    if p.bindings > 14 and p.name14.equals(name)
        give not p.mutable14
    if p.bindings > 15 and p.name15.equals(name)
        give not p.mutable15
    if p.bindings > 16 and p.name16.equals(name)
        give not p.mutable16
    if p.bindings > 17 and p.name17.equals(name)
        give not p.mutable17
    if p.bindings > 18 and p.name18.equals(name)
        give not p.mutable18
    if p.bindings > 19 and p.name19.equals(name)
        give not p.mutable19
    if p.bindings > 20 and p.name20.equals(name)
        give not p.mutable20
    if p.bindings > 21 and p.name21.equals(name)
        give not p.mutable21
    if p.bindings > 22 and p.name22.equals(name)
        give not p.mutable22
    if p.bindings > 23 and p.name23.equals(name)
        give not p.mutable23
    if p.bindings > 24 and p.name24.equals(name)
        give not p.mutable24
    if p.bindings > 25 and p.name25.equals(name)
        give not p.mutable25
    if p.bindings > 26 and p.name26.equals(name)
        give not p.mutable26
    if p.bindings > 27 and p.name27.equals(name)
        give not p.mutable27
    if p.bindings > 28 and p.name28.equals(name)
        give not p.mutable28
    if p.bindings > 29 and p.name29.equals(name)
        give not p.mutable29
    if p.bindings > 30 and p.name30.equals(name)
        give not p.mutable30
    if p.bindings > 31 and p.name31.equals(name)
        give not p.mutable31
    give false

# Type IDs preserve declared spelling. Number-like types are checked as a
# numeric family by the Stage-1 frontend; Stage 0 enforces exact conversions.
routine type_name(var p: Parser) gives int with trap
    if keyword(p, "int")
        give 1
    if keyword(p, "bool")
        give 2
    if keyword(p, "text")
        give 3
    if keyword(p, "string")
        give 4
    if keyword(p, "long")
        give 5
    if keyword(p, "float")
        give 6
    if keyword(p, "double")
        give 7
    if keyword(p, "char")
        give 8
    if keyword(p, "void")
        give 9
    if keyword(p, "byte")
        give 10
    if keyword(p, "short")
        give 11
    if keyword(p, "ubyte")
        give 12
    if keyword(p, "ushort")
        give 13
    if keyword(p, "uint")
        give 14
    if keyword(p, "ulong")
        give 15
    if keyword(p, "size")
        give 16
    if keyword(p, "ssize")
        give 17
    set_error(p, 6)
    give 0

routine type_text(kind: int) gives text
    if kind == 2
        give "bool"
    if kind == 3
        give "text"
    if kind == 4
        give "string"
    if kind == 5
        give "long"
    if kind == 6
        give "float"
    if kind == 7
        give "double"
    if kind == 8
        give "char"
    if kind == 9
        give "void"
    if kind == 10
        give "byte"
    if kind == 11
        give "short"
    if kind == 12
        give "ubyte"
    if kind == 13
        give "ushort"
    if kind == 14
        give "uint"
    if kind == 15
        give "ulong"
    if kind == 16
        give "size"
    if kind == 17
        give "ssize"
    give "int"

routine numeric_kind(kind: int) gives bool
    give kind == 1 or kind == 5 or kind == 6 or kind == 7 or (kind >= 10 and kind <= 17)

routine expr(kind: int) gives int
    give kind

routine combine(var p: Parser, left: int, operation: text, right: int, result_type: int) gives int
    give result_type

routine require_type(var p: Parser, actual: int, expected: int) gives void
    if p.error == 0 and actual != expected and actual != 0
        # Numeric literals and operations are provisionally numeric. Stage 0
        # performs the definitive width/range and no-implicit-cast checks.
        if not (numeric_kind(actual) and numeric_kind(expected))
            set_error(p, 7)

# Parse exactly one quoted literal, including its escapes. The native
# lexer already rejects malformed escapes and invalid UTF-8 before this pass.
routine quoted(var p: Parser, delimiter: int) gives void with trap
    if at(p) != delimiter
        set_error(p, 10)
    p.pos = p.pos + 1
    var terminated: bool = false
    while at(p) != -1 and at(p) != 10 and not terminated
        if at(p) == 92
            p.pos = p.pos + 1
            if at(p) == -1 or at(p) == 10
                set_error(p, 14)
            else
                p.pos = p.pos + 1
        else
            if at(p) == delimiter
                terminated = true
                p.pos = p.pos + 1
            else
                p.pos = p.pos + 1
    if not terminated
        set_error(p, 14)

# Library functions are recognized at the type level, not blindly treated as
# local variables. Stage 0 authoritatively verifies overloads and effects.
# Look up declared return types without storing whole AST nodes. This permits
# forward bool/text/string/float-returning calls using the tiny bootstrap subset.
routine declared_return_kind(source: text, name: text) gives int with trap
    let n: int = source.count().to_int()
    var pos: int = 0
    while pos + 8 < n
        if pos == 0 or source.byte_at(pos - 1) == 10
            if source.slice(pos, 8).equals("routine ")
                var at_name: int = pos + 8
                let name_start: int = at_name
                while at_name < n and is_word(source.byte_at(at_name))
                    at_name += 1
                if source.slice(name_start, at_name - name_start).equals(name)
                    var cursor: int = at_name
                    while cursor + 6 < n and source.byte_at(cursor) != 10
                        if source.slice(cursor, 6).equals("gives ")
                            let kind_begin: int = cursor + 6
                            var kind_end: int = kind_begin
                            while kind_end < n and is_word(source.byte_at(kind_end))
                                kind_end += 1
                            let found: text = source.slice(kind_begin, kind_end - kind_begin)
                            if found.equals("int")
                                give 1
                            if found.equals("bool")
                                give 2
                            if found.equals("text")
                                give 3
                            if found.equals("string")
                                give 4
                            if found.equals("long")
                                give 5
                            if found.equals("float")
                                give 6
                            if found.equals("double")
                                give 7
                            if found.equals("char")
                                give 8
                            give 0
                        cursor += 1
        pos += 1
    give 0

routine call_kind(name: text, source: text) gives int
    if name.equals("std.fs.exists") or name.equals("std.fs.write_text")
        give 2
    if name.equals("std.fs.read_text") or name.equals("std.io.read_all")
        give 4
    if name.equals("std.process.run")
        give 1
    give declared_return_kind(source, name)

routine primary(var p: Parser) gives int with alloc, trap
    skip_space(p)
    var kind: int = 0
    if token(p, "(")
        kind = expression(p)
        require_token(p, ")")
    else
        if at(p) == 34
            quoted(p, 34)
            kind = 3
        else
            if at(p) == 39
                quoted(p, 39)
                kind = 8
            else
                if is_digit(at(p))
                    if at(p) == 48 and (at_offset(p, 1) == 120 or at_offset(p, 1) == 88 or at_offset(p, 1) == 98 or at_offset(p, 1) == 66)
                        p.pos = p.pos + 2
                        while is_word(at(p))
                            p.pos = p.pos + 1
                    else
                        while is_digit(at(p)) or at(p) == 95
                            p.pos = p.pos + 1
                        if at(p) == 46 and is_digit(at_offset(p, 1))
                            kind = 7
                            p.pos = p.pos + 1
                            while is_digit(at(p)) or at(p) == 95
                                p.pos = p.pos + 1
                        if at(p) == 101 or at(p) == 69
                            kind = 7
                            p.pos = p.pos + 1
                            if at(p) == 43 or at(p) == 45
                                p.pos = p.pos + 1
                            while is_digit(at(p)) or at(p) == 95
                                p.pos = p.pos + 1
                    if kind == 0
                        kind = 1
                else
                    if keyword(p, "true") or keyword(p, "false")
                        kind = 2
                    else
                        if is_alpha(at(p))
                            let name: text = identifier(p)
                            var qualified = name.to_string()
                            if name.equals("std")
                                while token(p, ".")
                                    let next: text = identifier(p)
                                    qualified.append(".")
                                    qualified.append(next)
                            if token(p, "(")
                                if not token(p, ")")
                                    var reading: bool = true
                                    while reading and p.error == 0
                                        let argument: int = expression(p)
                                        if argument == 0 and p.error == 0
                                            set_error(p, 7)
                                        if not token(p, ",")
                                            require_token(p, ")")
                                            reading = false
                                kind = call_kind(qualified.to_text(), p.source)
                            else
                                kind = symbol_kind(p, name)
                                if kind == 0
                                    set_error(p, 9)
                        else
                            set_error(p, 10)
                            kind = 1
    # Text/string postfix member and method calls.
    var methods: bool = true
    while methods and p.error == 0
        if token(p, ".")
            let member: text = identifier(p)
            require_token(p, "(")
            if member.equals("to_string")
                require_type(p, kind, 3)
                require_token(p, ")")
                kind = 4
            else
                if member.equals("to_text")
                    require_type(p, kind, 4)
                    require_token(p, ")")
                    kind = 3
                else
                    if member.equals("count") or member.equals("codepoint_count")
                        if kind != 3 and kind != 4
                            set_error(p, 7)
                        require_token(p, ")")
                        kind = 1
                    else
                        if member.equals("to_int")
                            require_token(p, ")")
                            kind = 1
                        else
                            if member.equals("equals") or member.equals("starts_with") or member.equals("ends_with") or member.equals("contains")
                                if kind != 3 and kind != 4
                                    set_error(p, 7)
                                let arg: int = expression(p)
                                require_type(p, arg, 3)
                                require_token(p, ")")
                                kind = 2
                            else
                                if member.equals("byte_at") or member.equals("codepoint_at") or member.equals("find_byte")
                                    if kind != 3 and kind != 4
                                        set_error(p, 7)
                                    let arg: int = expression(p)
                                    require_type(p, arg, 1)
                                    require_token(p, ")")
                                    kind = 1
                                else
                                    if member.equals("slice")
                                        require_type(p, kind, 3)
                                        let first: int = expression(p)
                                        require_type(p, first, 1)
                                        require_token(p, ",")
                                        let second: int = expression(p)
                                        require_type(p, second, 1)
                                        require_token(p, ")")
                                        kind = 3
                                    else
                                        set_error(p, 23)
        else
            methods = false
    give kind

routine unary(var p: Parser) gives int with alloc, trap
    if token(p, "~")
        let value: int = unary(p)
        require_type(p, value, 1)
        give expr(1)
    if token(p, "-")
        let value: int = unary(p)
        require_type(p, value, 1)
        give expr(1)
    if token(p, "+")
        let value: int = unary(p)
        require_type(p, value, 1)
        give value
    if keyword(p, "not")
        let value: int = unary(p)
        require_type(p, value, 2)
        give expr(2)
    give primary(p)

routine product(var p: Parser) gives int with alloc, trap
    var left: int = unary(p)
    var working: bool = true
    while working and p.error == 0
        if token(p, "*")
            let right: int = unary(p)
            require_type(p, left, 1)
            require_type(p, right, 1)
            left = combine(p, left, "*", right, 1)
        else
            if token(p, "/")
                let right: int = unary(p)
                require_type(p, left, 1)
                require_type(p, right, 1)
                left = combine(p, left, "/", right, 1)
            else
                if token(p, "%")
                    let right: int = unary(p)
                    require_type(p, left, 1)
                    require_type(p, right, 1)
                    left = combine(p, left, "%", right, 1)
                else
                    working = false
    give left

routine sum(var p: Parser) gives int with alloc, trap
    var left: int = product(p)
    var working: bool = true
    while working and p.error == 0
        if token(p, "+")
            let right: int = product(p)
            require_type(p, left, 1)
            require_type(p, right, 1)
            left = combine(p, left, "+", right, 1)
        else
            if token(p, "-")
                let right: int = product(p)
                require_type(p, left, 1)
                require_type(p, right, 1)
                left = combine(p, left, "-", right, 1)
            else
                working = false
    give left

routine shift(var p: Parser) gives int with alloc, trap
    var left: int = sum(p)
    var reading: bool = true
    while reading and p.error == 0
        var found: bool = false
        if token(p, "<<")
            found = true
        else
            if token(p, ">>")
                found = true
        if found
            let right: int = sum(p)
            require_type(p, left, 1)
            require_type(p, right, 1)
            left = 1
        else
            reading = false
    give left

routine comparison(var p: Parser) gives int with alloc, trap
    var left: int = shift(p)
    var operation = "".to_string()
    if token(p, "==")
        operation.append("==")
    else
        if token(p, "!=")
            operation.append("!=")
        else
            if token(p, "<=")
                operation.append("<=")
            else
                if token(p, ">=")
                    operation.append(">=")
                else
                    if token(p, "<")
                        operation.append("<")
                    else
                        if token(p, ">")
                            operation.append(">")
    if not operation.to_text().is_empty()
        let right: int = shift(p)
        if operation.to_text().equals("==") or operation.to_text().equals("!=")
            if left != right and left != 0 and right != 0 and not (numeric_kind(left) and numeric_kind(right))
                set_error(p, 7)
        else
            require_type(p, left, 1)
            require_type(p, right, 1)
        left = combine(p, left, operation.to_text(), right, 2)
    give left

routine bit_and(var p: Parser) gives int with alloc, trap
    var left: int = comparison(p)
    while token(p, "&") and p.error == 0
        let right: int = comparison(p)
        require_type(p, left, 1)
        require_type(p, right, 1)
        left = 1
    give left

routine bit_xor(var p: Parser) gives int with alloc, trap
    var left: int = bit_and(p)
    while token(p, "^") and p.error == 0
        let right: int = bit_and(p)
        require_type(p, left, 1)
        require_type(p, right, 1)
        left = 1
    give left

routine bit_or(var p: Parser) gives int with alloc, trap
    var left: int = bit_xor(p)
    while token(p, "|") and p.error == 0
        let right: int = bit_xor(p)
        require_type(p, left, 1)
        require_type(p, right, 1)
        left = 1
    give left

routine conjunction(var p: Parser) gives int with alloc, trap
    var left: int = bit_or(p)
    while keyword(p, "and") and p.error == 0
        let right: int = bit_or(p)
        require_type(p, left, 2)
        require_type(p, right, 2)
        left = combine(p, left, "and", right, 2)
    give left

routine expression(var p: Parser) gives int with alloc, trap
    var left: int = conjunction(p)
    while keyword(p, "or") and p.error == 0
        let right: int = conjunction(p)
        require_type(p, left, 2)
        require_type(p, right, 2)
        left = combine(p, left, "or", right, 2)
    give left

routine indentation_text(n: int) gives string with alloc, trap
    var out = "".to_string()
    var count: int = 0
    while count < n
        out.append(" ")
        count += 1
    give out

routine append_line(var out: string, indentation: int, contents: text) gives void with alloc, trap
    let spaces: string = indentation_text(indentation)
    out.append(spaces.to_text())
    out.append(contents)
    out.append("\n")

routine statement(var p: Parser, depth: int, in_loop: bool) gives string with alloc, trap
    var out = "".to_string()
    let spaces: string = indentation_text(depth)
    p.pos = p.pos + depth
    var is_declaration: bool = false
    var mutable: bool = false
    if keyword(p, "let")
        is_declaration = true
    else
        if keyword(p, "var")
            is_declaration = true
            mutable = true
    if is_declaration
        let name: text = identifier(p)
        require_token(p, ":")
        let kind: int = type_name(p)
        require_token(p, "=")
        let start: int = p.pos
        let value: int = expression(p)
        require_type(p, value, kind)
        let original: text = p.source.slice(start, p.pos - start)
        line_end(p)
        if p.error == 0
            declare_symbol(p, name, kind, mutable)
        out.append(spaces.to_text())
        if mutable
            out.append("var ")
        else
            out.append("let ")
        out.append(name)
        out.append(": ")
        out.append(type_text(kind))
        out.append(" = ")
        out.append(original)
        out.append("\n")
        give out
    if keyword(p, "give")
        let start: int = p.pos
        let value: int = expression(p)
        require_type(p, value, p.return_kind)
        let original: text = p.source.slice(start, p.pos - start)
        line_end(p)
        out.append(spaces.to_text())
        out.append("give ")
        out.append(original)
        out.append("\n")
        give out
    if keyword(p, "if")
        let start: int = p.pos
        let condition: int = expression(p)
        require_type(p, condition, 2)
        let original: text = p.source.slice(start, p.pos - start)
        line_end(p)
        out.append(spaces.to_text())
        out.append("if ")
        out.append(original)
        out.append("\n")
        let saved: int = p.bindings
        let body: string = block(p, depth + 4, in_loop)
        out.append(body.to_text())
        p.bindings = saved
        if indentation(p) == depth and keyword(p, "else")
            line_end(p)
            out.append(spaces.to_text())
            out.append("else\n")
            let other: string = block(p, depth + 4, in_loop)
            out.append(other.to_text())
            p.bindings = saved
        give out
    if keyword(p, "while")
        let start: int = p.pos
        let condition: int = expression(p)
        require_type(p, condition, 2)
        let original: text = p.source.slice(start, p.pos - start)
        line_end(p)
        out.append(spaces.to_text())
        out.append("while ")
        out.append(original)
        out.append("\n")
        let saved: int = p.bindings
        let body: string = block(p, depth + 4, true)
        out.append(body.to_text())
        p.bindings = saved
        give out
    if keyword(p, "continue")
        if keyword(p, "until")
            let start: int = p.pos
            let condition: int = expression(p)
            require_type(p, condition, 2)
            let original: text = p.source.slice(start, p.pos - start)
            line_end(p)
            out.append(spaces.to_text())
            out.append("continue until ")
            out.append(original)
            out.append("\n")
            let saved: int = p.bindings
            let body: string = block(p, depth + 4, true)
            out.append(body.to_text())
            p.bindings = saved
            give out
        if not in_loop
            set_error(p, 11)
        line_end(p)
        append_line(out, depth, "continue")
        give out
    if keyword(p, "for")
        let name: text = identifier(p)
        require_keyword(p, "in")
        let start: int = p.pos
        # Fixed literal array iteration, with runtime body. Dynamic views,
        # ranges and guards are supported under --stage0-full by Stage 0.
        require_token(p, "[")
        var had_item: bool = false
        if not token(p, "]")
            var reading: bool = true
            while reading and p.error == 0
                let element: int = expression(p)
                require_type(p, element, 1)
                had_item = true
                if not token(p, ",")
                    require_token(p, "]")
                    reading = false
        let sequence: text = p.source.slice(start, p.pos - start)
        line_end(p)
        let saved: int = p.bindings
        declare_symbol(p, name, 1, false)
        out.append(spaces.to_text())
        out.append("for ")
        out.append(name)
        out.append(" in ")
        out.append(sequence)
        out.append("\n")
        let body: string = block(p, depth + 4, true)
        out.append(body.to_text())
        p.bindings = saved
        give out
    if keyword(p, "from")
        let name: text = identifier(p)
        require_token(p, ":")
        let kind: int = type_name(p)
        require_type(p, kind, 1)
        require_token(p, "=")
        let first_start: int = p.pos
        let first: int = expression(p)
        require_type(p, first, 1)
        let first_text: text = p.source.slice(first_start, p.pos - first_start)
        require_keyword(p, "to")
        let last_start: int = p.pos
        let last: int = expression(p)
        require_type(p, last, 1)
        let last_text: text = p.source.slice(last_start, p.pos - last_start)
        line_end(p)
        let saved: int = p.bindings
        declare_symbol(p, name, kind, false)
        out.append(spaces.to_text())
        out.append("from ")
        out.append(name)
        out.append(": ")
        out.append(type_text(kind))
        out.append(" = ")
        out.append(first_text)
        out.append(" to ")
        out.append(last_text)
        out.append("\n")
        let body: string = block(p, depth + 4, true)
        out.append(body.to_text())
        p.bindings = saved
        give out
    if keyword(p, "break")
        if not in_loop
            set_error(p, 11)
        line_end(p)
        append_line(out, depth, "break")
        give out
    let name: text = identifier(p)
    if name.equals("std") and token(p, ".")
        let ns: text = identifier(p)
        require_token(p, ".")
        let method: text = identifier(p)
        require_token(p, "(")
        let begin: int = p.pos
        let first_kind: int = expression(p)
        if ns.equals("io")
            if not method.equals("print") and not method.equals("println")
                set_error(p, 12)
            require_type(p, first_kind, 3)
        else
            if ns.equals("fs") and method.equals("write_text")
                require_type(p, first_kind, 3)
                require_token(p, ",")
                let second: int = expression(p)
                require_type(p, second, 3)
            else
                set_error(p, 12)
        let original: text = p.source.slice(begin, p.pos - begin)
        require_token(p, ")")
        line_end(p)
        out.append(spaces.to_text())
        out.append("std.")
        out.append(ns)
        out.append(".")
        out.append(method)
        out.append("(")
        out.append(original)
        out.append(")\n")
        give out
    let kind: int = symbol_kind(p, name)
    if kind == 0
        set_error(p, 9)
    if is_immutable(p, name)
        set_error(p, 15)
    var operation = "".to_string()
    if token(p, "+=")
        operation.append("+=")
    else
        if token(p, "-=")
            operation.append("-=")
        else
            if token(p, "*=")
                operation.append("*=")
            else
                if token(p, "/=")
                    operation.append("/=")
                else
                    if token(p, "%=")
                        operation.append("%=")
                    else
                        if token(p, "&=")
                            operation.append("&=")
                        else
                            if token(p, "|=")
                                operation.append("|=")
                            else
                                if token(p, "^=")
                                    operation.append("^=")
                                else
                                    if token(p, "<<=")
                                        operation.append("<<=")
                                    else
                                        if token(p, ">>=")
                                            operation.append(">>=")
                                        else
                                            if token(p, "=")
                                                operation.append("=")
                                            else
                                                set_error(p, 3)
    let start: int = p.pos
    let value: int = expression(p)
    require_type(p, value, kind)
    if not operation.to_text().equals("=")
        require_type(p, kind, 1)
    let original: text = p.source.slice(start, p.pos - start)
    line_end(p)
    out.append(spaces.to_text())
    out.append(name)
    out.append(" ")
    out.append(operation.to_text())
    out.append(" ")
    out.append(original)
    out.append("\n")
    give out

routine block(var p: Parser, depth: int, in_loop: bool) gives string with alloc, trap
    var out = "".to_string()
    if depth > 128
        set_error(p, 16)
        give out
    var count: int = 0
    var processing: bool = true
    while processing and p.error == 0
        let actual: int = indentation(p)
        if p.pos >= length(p) or actual < depth
            processing = false
        else
            if actual != depth
                set_error(p, 5)
            else
                let line: string = statement(p, depth, in_loop)
                out.append(line.to_text())
                count += 1
    if count == 0 and p.error == 0
        let actual: int = indentation(p)
        if actual % 4 != 0
            set_error(p, 5)
        else
            set_error(p, 17)
    give out

routine compile_source(source: text, var out: string) gives Result with alloc, trap
    var p: Parser = Parser{source: source, pos: 0, error: 0, error_pos: 0, bindings: 0, routines: 0, saw_main: false, return_kind: 1, name0: "", kind0: 0, mutable0: false, name1: "", kind1: 0, mutable1: false, name2: "", kind2: 0, mutable2: false, name3: "", kind3: 0, mutable3: false, name4: "", kind4: 0, mutable4: false, name5: "", kind5: 0, mutable5: false, name6: "", kind6: 0, mutable6: false, name7: "", kind7: 0, mutable7: false, name8: "", kind8: 0, mutable8: false, name9: "", kind9: 0, mutable9: false, name10: "", kind10: 0, mutable10: false, name11: "", kind11: 0, mutable11: false, name12: "", kind12: 0, mutable12: false, name13: "", kind13: 0, mutable13: false, name14: "", kind14: 0, mutable14: false, name15: "", kind15: 0, mutable15: false, name16: "", kind16: 0, mutable16: false, name17: "", kind17: 0, mutable17: false, name18: "", kind18: 0, mutable18: false, name19: "", kind19: 0, mutable19: false, name20: "", kind20: 0, mutable20: false, name21: "", kind21: 0, mutable21: false, name22: "", kind22: 0, mutable22: false, name23: "", kind23: 0, mutable23: false, name24: "", kind24: 0, mutable24: false, name25: "", kind25: 0, mutable25: false, name26: "", kind26: 0, mutable26: false, name27: "", kind27: 0, mutable27: false, name28: "", kind28: 0, mutable28: false, name29: "", kind29: 0, mutable29: false, name30: "", kind30: 0, mutable30: false, name31: "", kind31: 0, mutable31: false}
    let scan: Result = lexical_preflight(source)
    if not scan.ok
        give scan
    if length(p) >= 3
        if source.byte_at(0) == 239 and source.byte_at(1) == 187 and source.byte_at(2) == 191
            p.pos = 3
    skip_empty(p)
    if keyword(p, "module")
        let name: text = identifier(p)
        out.append("module ")
        out.append(name)
        while token(p, ".")
            let part: text = identifier(p)
            out.append(".")
            out.append(part)
        out.append("\n")
        line_end(p)
    else
        out.append("module stage1_output\n")
    skip_empty(p)
    var imports: bool = true
    var used_io: bool = false
    while imports and p.error == 0
        if keyword(p, "import")
            let name: text = identifier(p)
            out.append("import ")
            out.append(name)
            if name.equals("std") and token(p, ".")
                let part: text = identifier(p)
                out.append(".")
                out.append(part)
                if part.equals("io")
                    used_io = true
            out.append("\n")
            line_end(p)
            skip_empty(p)
        else
            imports = false
    if not used_io
        out.append("import std.io\n")
    while p.pos < length(p) and p.error == 0
        skip_empty(p)
        if p.pos < length(p)
            require_keyword(p, "routine")
            let name: text = identifier(p)
            p.bindings = 0
            if name.equals("main")
                if p.saw_main
                    set_error(p, 22)
                p.saw_main = true
            var signature = "routine ".to_string()
            signature.append(name)
            signature.append("(")
            var param_count: int = 0
            require_token(p, "(")
            if not token(p, ")")
                var params: bool = true
                while params and p.error == 0
                    let pname: text = identifier(p)
                    param_count += 1
                    require_token(p, ":")
                    let ptype: int = type_name(p)
                    if ptype == 9
                        set_error(p, 7)
                    declare_symbol(p, pname, ptype, false)
                    signature.append(pname)
                    signature.append(": ")
                    signature.append(type_text(ptype))
                    if token(p, ",")
                        signature.append(", ")
                    else
                        require_token(p, ")")
                        params = false
            signature.append(")")
            if name.equals("main") and param_count != 0
                set_error(p, 21)
            require_keyword(p, "gives")
            let returning: int = type_name(p)
            if name.equals("main")
                require_type(p, returning, 1)
            p.return_kind = returning
            signature.append(" gives ")
            signature.append(type_text(returning))
            if keyword(p, "with")
                # Preserve explicit effect contracts exactly. Stage 0 checks
                # whether each body and its callees stay within the declared effects.
                signature.append(" with ")
                var parsing_effects: bool = true
                var wrote_effect: bool = false
                while parsing_effects and p.error == 0
                    let effect: text = identifier(p)
                    if not effect.equals("io") and not effect.equals("alloc") and not effect.equals("trap") and not effect.equals("pure") and not effect.equals("thread") and not effect.equals("unsafe")
                        set_error(p, 25)
                    if wrote_effect
                        signature.append(", ")
                    signature.append(effect)
                    wrote_effect = true
                    if not token(p, ",")
                        parsing_effects = false
            else
                # Unannotated small-subset routines get a permissive effect
                # set; Stage 0 retains definitive native effect checking.
                signature.append(" with io, alloc, trap")
            signature.append("\n")
            line_end(p)
            out.append(signature.to_text())
            let body: string = block(p, 4, false)
            out.append(body.to_text())
            p.routines = p.routines + 1
    if p.routines == 0 and p.error == 0
        set_error(p, 18)
    if not p.saw_main and p.error == 0
        set_error(p, 19)
    give Result{ok: p.error == 0, error: p.error, offset: p.error_pos}

routine number_text(value: int) gives string with alloc, trap
    if value == 0
        give "0".to_string()
    var n: int = value
    var rev = "".to_string()
    var result = "".to_string()
    var digits: int = 0
    while n > 0
        let digit: int = n % 10
        if digit == 0
            rev.append("0")
        if digit == 1
            rev.append("1")
        if digit == 2
            rev.append("2")
        if digit == 3
            rev.append("3")
        if digit == 4
            rev.append("4")
        if digit == 5
            rev.append("5")
        if digit == 6
            rev.append("6")
        if digit == 7
            rev.append("7")
        if digit == 8
            rev.append("8")
        if digit == 9
            rev.append("9")
        digits += 1
        n /= 10
    while digits > 0
        digits -= 1
        result.append(rev.to_text().slice(digits, 1))
    give result

routine error_message(code: int) gives text
    if code == 1
        give "expected identifier"
    if code == 2
        give "expected keyword"
    if code == 3
        give "expected punctuation or assignment operator"
    if code == 4
        give "expected end of statement"
    if code == 5
        give "invalid indentation (four spaces per level)"
    if code == 6
        give "unsupported type in strict Stage-1 subset"
    if code == 7
        give "type mismatch in expression or declaration"
    if code == 8
        give "duplicate local variable or parameter"
    if code == 9
        give "unknown variable name"
    if code == 10
        give "expected expression"
    if code == 11
        give "break or continue requires a loop"
    if code == 12
        give "unsupported std.io method"
    if code == 13
        give "print requires a text expression"
    if code == 14
        give "unterminated text literal"
    if code == 15
        give "cannot assign to immutable let or parameter"
    if code == 16
        give "maximum nesting depth exceeded"
    if code == 17
        give "expected nonempty indented block"
    if code == 18
        give "expected at least one routine"
    if code == 19
        give "main routine is required"
    if code == 20
        give "too many active local bindings (maximum 32)"
    if code == 21
        give "main must take no parameters in this subset"
    if code == 22
        give "duplicate main routine"
    if code == 23
        give "unsupported postfix method in strict Stage-1 subset"
    if code == 25
        give "unknown declared effect name"
    if code == 101
        give "tabs are forbidden in structural indentation"
    if code == 102
        give "indentation must be a multiple of four spaces"
    if code == 103
        give "top-level indentation or skipped nesting level"
    if code == 109
        give "unexpected character"
    if code == 110
        give "unterminated string literal"
    if code == 111
        give "unmatched or mismatched delimiter"
    if code == 112
        give "unclosed grouping delimiter"
    if code == 113
        give "malformed numeric exponent"
    if code == 115
        give "malformed character literal"
    if code == 116
        give "maximum grouping depth exceeded"
    if code == 117
        give "token limit exceeded"
    if code == 114
        give "invalid numeric literal or separator"
    if code == 118
        give "invalid UTF-8 source"
    give "syntax error"

routine report_error(source: text, result: Result) gives int with alloc, trap, io
    var line: int = 1
    var column: int = 1
    var pos: int = 0
    while pos < result.offset and pos < source.count().to_int()
        if source.byte_at(pos) == 10
            line += 1
            column = 1
        else
            column += 1
        pos += 1
    var message = "Stage-1 error E".to_string()
    message.append(number_text(result.error).to_text())
    message.append(" at ")
    message.append(number_text(line).to_text())
    message.append(":")
    message.append(number_text(column).to_text())
    message.append(": ")
    message.append(error_message(result.error))
    message.append("\n")
    if not message.to_text().stderr_write()
        give 3
    give 1

# Stage-1 driver: native executable generation is delegated to Stage 0.
# All CLI parsing, validation, source output, and process control is Paracine.
# Stage 0 provides std.process.run(command_line: text) to launch Windows tasks.

routine safe_command_piece(value: text) gives bool with trap
    if value.count().to_int() == 0
        give false
    var i: int = 0
    while i < value.count().to_int()
        let b: int = value.byte_at(i)
        if b == 0 or b == 10 or b == 13 or b == 34
            give false
        i += 1
    give true

routine append_quoted(var command: string, argument: text) gives void with alloc, trap
    command.append("\"")
    command.append(argument)
    command.append("\"")

routine stage0_build(stage0: text, intermediate: text, executable: text, optimize: text) gives int with alloc, trap, io
    if not safe_command_piece(stage0) or not safe_command_piece(intermediate) or not safe_command_piece(executable)
        if not "Invalid command path or embedded quotation mark\n".stderr_write()
            give 3
        give 2
    var command = "".to_string()
    append_quoted(command, stage0)
    command.append(" pe ")
    append_quoted(command, intermediate)
    command.append(" ")
    command.append(optimize)
    command.append(" -o ")
    append_quoted(command, executable)
    give std.process.run(command.to_text())

routine stage1_cli(args: view<text>) gives int with alloc, trap, io
    if args.count == 1 and args[0].equals("--version")
        std.io.println("Paracine Stage-1 compiler 0.4.1; extended subset + explicit Stage-0 compatibility")
        give 0
    if args.count == 0 or args[0].equals("--help")
        std.io.println("ParacineCompiler emit input.pcn [-o output.pcn]")
        std.io.println("ParacineCompiler check input.pcn")
        std.io.println("ParacineCompiler tokens input.pcn")
        std.io.println("ParacineCompiler build input.pcn [-o output.exe] [--stage0 Paracine] [-O0|-O3]")
        std.io.println("ParacineCompiler run input.pcn [-o output.exe] [--stage0 Paracine] [-O0|-O3]")
        std.io.println("Add --stage0-full to use the complete *currently supported* Stage-0 grammar")
        std.io.println("Legacy: ParacineCompiler input.pcn [-o output.pcn]")
        give 0
    var mode: text = args[0]
    var source_path: text = ""
    var output_path: text = ""
    var stage0: text = "Paracine"
    var optimize: text = "-O3"
    var stage0_full: bool = false
    var position: int = 1
    if args[0].equals("--tokens")
        mode = "tokens"
    if args[0].equals("--check")
        mode = "check"
    if mode.equals("tokens") or mode.equals("check") or mode.equals("emit") or mode.equals("build") or mode.equals("run")
        if args.count < 2
            if not "Missing .pcn input path\n".stderr_write()
                give 3
            give 2
        source_path = args[1]
        position = 2
    else
        mode = "emit"
        source_path = args[0]
        position = 1
    while position < args.count.to_int()
        if args[position].equals("-o")
            if position + 1 >= args.count.to_int()
                if not "Expected an output filename after -o\n".stderr_write()
                    give 3
                give 2
            output_path = args[position + 1]
            position += 2
        else
            if args[position].equals("--stage0")
                if position + 1 >= args.count.to_int()
                    if not "Expected a compiler filename after --stage0\n".stderr_write()
                        give 3
                    give 2
                stage0 = args[position + 1]
                position += 2
            else
                if args[position].equals("--stage0-full")
                    stage0_full = true
                    position += 1
                else
                    if args[position].equals("-O0") or args[position].equals("-O3")
                        optimize = args[position]
                        position += 1
                    else
                        if not "Unknown command-line option\n".stderr_write()
                            give 3
                        give 2
    if not source_path.ends_with(".pcn")
        if not "Input file must end with .pcn\n".stderr_write()
            give 3
        give 2
    if not std.fs.exists(source_path)
        if not "Input .pcn file does not exist\n".stderr_write()
            give 3
        give 2
    let source: string = std.fs.read_text(source_path)
    if mode.equals("tokens")
        give dump_tokens(source.to_text())
    var generated = "".to_string()
    if stage0_full
        # Stage-0 compatibility mode never claims independent Stage-1 analysis.
        # Stage 0 owns semantic validation, code generation, and diagnostics.
        generated.append(source.to_text())
    else
        let result: Result = compile_source(source.to_text(), generated)
        if not result.ok
            give report_error(source.to_text(), result)
    if mode.equals("check")
        if stage0_full
            var command = "".to_string()
            append_quoted(command, stage0)
            command.append(" check ")
            append_quoted(command, source_path)
            give std.process.run(command.to_text())
        std.io.println("Stage-1 syntax and subset semantics verified")
        give 0
    if mode.equals("emit")
        if output_path.count().to_int() == 0
            if not generated.to_text().stdout_write()
                give 3
            give 0
        if not output_path.ends_with(".pcn")
            if not "Emit output must end with .pcn\n".stderr_write()
                give 3
            give 2
        if not std.fs.write_text(output_path, generated.to_text())
            if not "Failed to write generated source\n".stderr_write()
                give 3
            give 4
        give 0
    if output_path.count().to_int() == 0
        output_path = "stage1_program.exe"
    if not output_path.ends_with(".exe")
        if not "Build output must end with .exe\n".stderr_write()
            give 3
        give 2
    if not safe_command_piece(output_path) or not safe_command_piece(stage0)
        if not "Invalid executable/compiler path\n".stderr_write()
            give 3
        give 2
    var intermediate = output_path.to_string()
    intermediate.append(".stage1.pcn")
    if not std.fs.write_text(intermediate.to_text(), generated.to_text())
        if not "Failed to write Stage-1 intermediate .pcn\n".stderr_write()
            give 3
        give 4
    let status: int = stage0_build(stage0, intermediate.to_text(), output_path, optimize)
    if status != 0
        if not "Stage 0 native compilation failed\n".stderr_write()
            give 3
        if status < 0
            give 5
        give status
